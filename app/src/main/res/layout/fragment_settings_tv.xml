<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V4: Settings TV rediseñado.
  Igual que mobile pero con botones focusables TV (wlf_bg_*_tv).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wlf_bg_details_fragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/iv_settings_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wlfmovie_logo"
                tools:ignore="ContentDescription" />

            <!-- WlfMovie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-black"
                android:text="WlfMovie"
                android:textColor="@color/wlf_text_primary"
                android:textSize="32sp" />

            <!-- Username -->
            <TextView
                android:id="@+id/tv_settings_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:fontFamily="sans-serif-light"
                android:text="Sin usuario"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="20sp" />

            <!-- Botón Iniciar sesión -->
            <TextView
                android:id="@+id/btn_settings_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/wlf_bg_play_button_details"
                android:clickable="true"
                android:drawableStart="@drawable/wlf_ic_play"
                android:drawablePadding="12dp"
                android:drawableTint="@color/wlf_text_primary"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Iniciar sesión para sincronizar"
                android:textColor="@color/wlf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Botón Sincronizar -->
            <TextView
                android:id="@+id/btn_settings_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/wlf_bg_play_button_details"
                android:clickable="true"
                android:drawableStart="@drawable/wlf_ic_play"
                android:drawablePadding="12dp"
                android:drawableTint="@color/wlf_text_primary"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Sincronizar ahora"
                android:textColor="@color/wlf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Última sync -->
            <TextView
                android:id="@+id/tv_settings_last_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Botón Cerrar sesión -->
            <TextView
                android:id="@+id/btn_settings_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:background="@drawable/wlf_bg_secondary_button_details"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Cerrar sesión"
                android:textColor="@color/wlf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="#33FFFFFF" />

            <!-- Términos -->
            <TextView
                android:id="@+id/btn_settings_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:background="@drawable/wlf_bg_icon_button_tv"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Términos y condiciones"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="18sp" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="#33FFFFFF" />

            <!-- Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="WlfMovie"
                android:textColor="@color/wlf_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="16sp"
                tools:text="Versión 2.100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:text="Datos proporcionados por TMDB"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/pb_settings_loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateDrawable="@drawable/wlf_loading_spinner"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
