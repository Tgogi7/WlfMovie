<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V6.1: Pantalla de error cuando no hay servers disponibles.
  No destruye el player ni sobrescribe el progreso.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_error_servers"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="@color/wlf_bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    tools:visibility="visible">

    <!-- Icono de error -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_remote_stop"
        android:tint="@color/wlf_fuchsia_neon"
        tools:ignore="UseAppTint" />

    <!-- Título del error -->
    <TextView
        android:id="@+id/tv_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No se encontraron servidores"
        android:textColor="@color/wlf_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Mensaje contextual -->
    <TextView
        android:id="@+id/tv_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="14sp"
        tools:text="Puede ser un error temporal en los servidores. Reintenta ahora o en unos minutos." />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Cancelar -->
        <TextView
            android:id="@+id/btn_error_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp"
            android:text="Cancelar"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Reintentar -->
        <TextView
            android:id="@+id/btn_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp"
            android:text="↻ Reintentar"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- WLFMOVIE YETI v9: Botón "Intentar con Opción 2" / "Intentar normal".
         Visible solo si el toggle "Segundo reproductor" está ON.
         Si el intento actual fue normal → muestra "Intentar con 🐢 Opción 2"
         Si el intento actual fue YP → muestra "Intentar normal" -->
    <TextView
        android:id="@+id/btn_error_try_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/wlf_bg_secondary_button_details"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:text="🐢 Intentar Opción 2"
        android:textColor="@color/wlf_fuchsia_neon"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
