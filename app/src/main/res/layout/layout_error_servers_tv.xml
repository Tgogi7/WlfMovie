<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V6.1: Pantalla de error cuando no hay servidores (TV).
  Con soporte D-pad: botones focusables, focusableInTouchMode, nextFocusLeft/Right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_error_servers_tv"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wlf_bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Icono de error -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ic_remote_stop"
        android:tint="@color/wlf_fuchsia_neon"
        tools:ignore="UseAppTint" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No se encontraron servidores"
        android:textColor="@color/wlf_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Mensaje -->
    <TextView
        android:id="@+id/tv_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:maxWidth="600dp"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="16sp"
        tools:text="Puede ser un error temporal en los servidores." />

    <!-- Botones con D-pad support -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Cancelar -->
        <TextView
            android:id="@+id/btn_error_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="160dp"
            android:nextFocusRight="@id/btn_error_retry"
            android:padding="18dp"
            android:text="Cancelar"
            android:textColor="@color/wlf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Reintentar -->
        <TextView
            android:id="@+id/btn_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="160dp"
            android:nextFocusLeft="@id/btn_error_cancel"
            android:padding="18dp"
            android:text="↻ Reintentar"
            android:textColor="@color/wlf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- WLFMOVIE YETI v9: Botón "Intentar con Opción 2" / "Intentar normal" (TV).
         Visible solo si el toggle "Segundo reproductor" está ON. -->
    <TextView
        android:id="@+id/btn_error_try_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/wlf_bg_secondary_button_details"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:minWidth="200dp"
        android:nextFocusUp="@id/btn_error_retry"
        android:padding="18dp"
        android:text="🐢 Intentar Opción 2"
        android:textColor="@color/wlf_fuchsia_neon"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
