<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE: Search TV rediseñado.
  - Fondo morado oscuro.
  - Barra de búsqueda estilizada con bordes morado-fucsia (como en android).
  - Sin "Búsqueda Global" (TMDB lo tiene todo).
  - Chips de géneros debajo.
  - Grid de resultados debajo.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wlf_bg_details_fragment"
    tools:context=".fragments.search.SearchTvFragment">

    <!-- Barra de búsqueda estilizada WlfMovie (como en android).
         Usa wlf_bg_search_edittext que tiene borde morado-fucsia. -->
    <LinearLayout
        android:id="@+id/cl_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="100dp"
        android:background="@drawable/wlf_bg_search_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.leanback.widget.SearchEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="#E879F9"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusRight="@+id/btn_search_clear"
            android:nextFocusDown="@id/rv_genres"
            android:padding="14dp"
            android:textColor="@color/wlf_text_primary"
            android:textColorHint="#B8B8D1"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/wlf_bg_icon_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btn_search_voice"
            android:nextFocusDown="@id/rv_genres"
            android:padding="12dp"
            android:src="@drawable/ic_search_clear"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/wlf_bg_icon_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/rv_genres"
            android:padding="12dp"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF"
            tools:ignore="PrivateResource,UseAppTint" />

    </LinearLayout>

    <!-- WLFMOVIE: "Búsqueda Global" eliminado — TMDB lo tiene todo.
         Se mantiene el LinearLayout oculto para no romper el binding. -->
    <LinearLayout
        android:id="@+id/ll_global_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/cl_search">

        <TextView
            android:id="@+id/tv_global_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/global_search"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/iv_global_search_switch"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_switch_off"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- Chips de géneros deslizables (1 fila horizontal).
         RecyclerView normal (NO Leanback) para evitar crash de foco. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:nextFocusUp="@id/cl_search"
        android:nextFocusDown="@id/vgv_search"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_search" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:nextFocusUp="@id/rv_genres"
        android:padding="16dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_genres"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
