<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V4: Settings mobile rediseñado.
  Back button FIJO arriba. ScrollView DEBAJO del back button.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wlf_bg_details_fragment">

    <!-- Back button FIJO arriba -->
    <ImageView
        android:id="@+id/btn_settings_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Volver"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/wlf_ic_details_back"
        android:tint="@color/wlf_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseAppTint" />

    <!-- ScrollView DEBAJO del back button -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_settings_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <ImageView
                android:id="@+id/iv_settings_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wlfmovie_logo"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-black"
                android:text="WlfMovie"
                android:textColor="@color/wlf_text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_settings_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:fontFamily="sans-serif-light"
                android:text="Sin usuario"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_settings_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/wlf_bg_play_button_details"
                android:clickable="true"
                android:drawableStart="@drawable/wlf_ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/wlf_text_primary"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Iniciar sesión para sincronizar"
                android:textColor="@color/wlf_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_settings_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/wlf_bg_play_button_details"
                android:clickable="true"
                android:drawableStart="@drawable/wlf_ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/wlf_text_primary"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Sincronizar ahora"
                android:textColor="@color/wlf_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_settings_last_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_settings_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:background="@drawable/wlf_bg_secondary_button_details"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Cerrar sesión"
                android:textColor="@color/wlf_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/btn_settings_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Términos y condiciones"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="WlfMovie"
                android:textColor="@color/wlf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="14sp"
                tools:text="Versión 2.100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:text="Datos proporcionados por TMDB"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/pb_settings_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateDrawable="@drawable/wlf_loading_spinner"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
