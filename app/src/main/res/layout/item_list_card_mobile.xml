<?xml version="1.0" encoding="utf-8"?>
<!--
  Card de película/serie para la lista, con botón X para quitar.
  Carátula pequeña (100x150) con X arriba a la derecha.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp">

    <!-- Carátula -->
    <ImageView
        android:id="@+id/iv_list_item_poster"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón X para quitar -->
    <ImageView
        android:id="@+id/btn_list_item_remove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/wlf_bg_icon_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/wlf_ic_remove"
        app:layout_constraintEnd_toEndOf="@id/iv_list_item_poster"
        app:layout_constraintTop_toTopOf="@id/iv_list_item_poster" />

    <!-- Título (opcional, debajo de la carátula) -->
    <TextView
        android:id="@+id/tv_list_item_title"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lines="1"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_list_item_poster" />

</androidx.constraintlayout.widget.ConstraintLayout>
