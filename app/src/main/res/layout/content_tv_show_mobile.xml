<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE - Layout rediseñado de detalles de serie (Netflix-style).
  Mantiene los mismos IDs que el original para que TvShowViewHolder siga funcionando.

  Estructura:
  ┌──────────────────────────────────────┐
  │         BACKDROP (16:9)              │ ← iv_tv_show_poster (repurposed)
  │  ──────────────────────────────────  │ ← gradiente
  │  Título grande                       │ ← tv_tv_show_title
  │  ★ 8.5 · 2022 · 10 eps · HD          │ ← tags
  │  Fantasía, Drama, Aventura           │ ← tv_tv_show_genres
  │  [▶ Ver T1 E1]  [Ver temporadas]     │ ← btn_tv_show_watch_now + btn_seasons (nuevo)
  │  Sinopsis completa...                │ ← tv_tv_show_overview
  └──────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- ===== BACKDROP (16:9) ===== -->
    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/backdrops" />

    <!-- Gradiente sobre el backdrop -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/wlf_bg_details_gradient"
        app:layout_constraintBottom_toBottomOf="@id/iv_tv_show_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintStart_toStartOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="@id/iv_tv_show_poster" />

    <!-- Botón favorito (mantiene ID original) -->
    <ImageView
        android:id="@+id/btn_tv_show_favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/wlf_ic_heart_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseAppTint" />

    <!-- ===== TÍTULO ===== -->
    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="@color/wlf_text_primary"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tv_show_poster"
        tools:text="La casa del dragón" />

    <!-- ===== TAGS ===== -->
    <LinearLayout
        android:id="@+id/ll_tv_show_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title">

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            android:tint="@color/wlf_fuchsia_neon"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_fuchsia_neon"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="8.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="14sp"
            tools:text="2022" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="14sp"
            tools:text="10 eps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:textColor="@color/wlf_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="HD" />
    </LinearLayout>

    <!-- ===== GÉNEROS ===== -->
    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_tags"
        tools:text="Fantasía, Drama, Aventura" />

    <!-- ===== BOTONES: Ver T1 E1 + Ver temporadas ===== -->
    <LinearLayout
        android:id="@+id/ll_tv_show_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres">

        <!-- Botón Ver T1 E1 (mantiene ID original) -->
        <TextView
            android:id="@+id/btn_tv_show_watch_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:drawableStart="@drawable/wlf_ic_play"
            android:drawablePadding="10dp"
            android:drawableTint="@color/wlf_text_primary"
            android:focusable="true"
            android:gravity="center"
            android:text="Ver T1 E1"
            android:textColor="@color/wlf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botón Ver temporadas (NUEVO) -->
        <TextView
            android:id="@+id/btn_tv_show_seasons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ver temporadas"
            android:textColor="@color/wlf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de progreso del episodio -->
    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/wlf_seekbar_track"
        android:progressTint="@color/wlf_fuchsia_neon"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_buttons"
        tools:progress="80"
        tools:visibility="visible" />

    <!-- Botón Tráiler eliminado por petición del usuario -->

    <!-- ===== SINOPSIS ===== -->
    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-light"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode"
        tools:text="Sinopsis de la serie..." />

    <!-- Botón tráiler oculto (mantiene ID para que ViewHolder no rompa) -->
    <TextView
        android:id="@+id/btn_tv_show_trailer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
