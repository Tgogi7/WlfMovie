<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V6.3.1: Diálogo "Cancelar descarga".
  Casi idéntico a dialog_delete_download.xml pero con strings de cancel.
  Cancelar = detener la descarga en curso Y borrar todo lo que se descargó
  hasta el momento (segmentos + archivo parcial).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/wlf_bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Icono (X / stop) -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_remote_stop"
        android:tint="@color/wlf_fuchsia_neon"
        tools:ignore="UseAppTint" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/wlf_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="@string/download_cancel_dialog_title" />

    <!-- Mensaje -->
    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="14sp"
        tools:text="@string/download_cancel_dialog_body" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Seguir descargando -->
        <TextView
            android:id="@+id/btn_keep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/download_cancel_dialog_keep"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Cancelar y borrar -->
        <TextView
            android:id="@+id/btn_cancel_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/download_cancel_dialog_confirm"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
