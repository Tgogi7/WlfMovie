<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE - Fragment de detalles de película rediseñado.
  Fondo con gradiente morado oscuro + overlay de back/+/♥ fijos arriba.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wlf_bg_details_fragment"
    tools:context=".fragments.movie.MovieMobileFragment">

    <!-- RecyclerView con el contenido -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_movie"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="1"
        tools:listitem="@layout/content_movie_mobile" />

    <!-- ===== OVERLAY: Back (top left) ===== -->
    <ImageView
        android:id="@+id/btn_overlay_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Volver"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/wlf_ic_details_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== OVERLAY: Ver después (top right, al lado de favorito) ===== -->
    <ImageView
        android:id="@+id/btn_overlay_watch_later"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Ver después"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/wlf_ic_watch_later"
        app:layout_constraintEnd_toStartOf="@id/btn_overlay_favorite"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== OVERLAY: Favorito (top right) ===== -->
    <!-- Nota: el favorito también está en content_movie_mobile.xml (btn_movie_favorite)
         pero este overlay está siempre visible (no se va con el scroll). -->
    <ImageView
        android:id="@+id/btn_overlay_favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Favorito"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/wlf_ic_heart_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Loading -->
    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
