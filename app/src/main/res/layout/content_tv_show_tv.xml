<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE: Detalle de serie TV rediseñado (HBO Max TV style).
  Igual que content_movie_tv.xml pero con 2 botones (Ver T1 E1 + Ver temporadas).
  Layout 2 columnas:
    IZQUIERDA: backdrop + título + tags + géneros
    DERECHA:   botones "Ver T1 E1" + "Ver temporadas" (centrados verticalmente)
  DEBAJO (ancho completo): sinopsis
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Guideline al 60% para dividir las 2 columnas -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <!-- ===== COLUMNA IZQUIERDA ===== -->
    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="@id/guideline_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/backdrops" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="@color/wlf_text_primary"
        android:textSize="32sp"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="@id/guideline_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tv_show_poster"
        tools:text="La casa del dragón" />

    <!-- Tags -->
    <LinearLayout
        android:id="@+id/ll_tv_show_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/guideline_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title">

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            android:tint="@color/wlf_fuchsia_neon"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_fuchsia_neon"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="8.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="16sp"
            tools:text="2022" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="16sp"
            tools:text="10 eps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="@color/wlf_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:textColor="@color/wlf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="HD" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/guideline_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_tags"
        tools:text="Fantasía, Drama, Aventura" />

    <!-- ===== COLUMNA DERECHA: botones (centrados verticalmente con el backdrop) ===== -->
    <LinearLayout
        android:id="@+id/ll_tv_show_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@id/iv_tv_show_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_middle"
        app:layout_constraintTop_toTopOf="@id/iv_tv_show_poster">

        <!-- Botón Ver T1 E1 -->
        <TextView
            android:id="@+id/btn_tv_show_watch_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:drawableStart="@drawable/wlf_ic_play"
            android:drawablePadding="10dp"
            android:drawableTint="@color/wlf_text_primary"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Ver T1 E1"
            android:textColor="@color/wlf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Botón Ver temporadas -->
        <TextView
            android:id="@+id/btn_tv_show_seasons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Ver temporadas"
            android:textColor="@color/wlf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de progreso oculta (mantiene ID para que ViewHolder no rompa).
         En TV no mostramos la barra gris, mostramos texto. -->
    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_middle"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_buttons"
        tools:progress="80" />

    <!-- Texto "Visto S1 E2 · 23 min" (NUEVO en TV, reemplaza la barra) -->
    <TextView
        android:id="@+id/tv_tv_show_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="48dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/wlf_fuchsia_neon"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_middle"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_buttons"
        tools:text="Visto S1 E2 · 23 min"
        tools:visibility="visible" />

    <!-- ===== SINOPSIS (ancho completo) ===== -->
    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:fontFamily="sans-serif-light"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        tools:text="Sinopsis de la serie..." />

    <!-- ===== Botones ocultos ===== -->
    <TextView
        android:id="@+id/btn_tv_show_trailer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_tv_show_favorite"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
