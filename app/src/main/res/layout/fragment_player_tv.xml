<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE: Fragment del player TV rediseñado.
  Gemelo del mobile PERO sin barras laterales de brillo/volumen.
  El controller (content_exo_controller_tv.xml) se carga dentro del PlayerTvView.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".fragments.player.PlayerTvFragment">

    <com.mew.wlfmovie.ui.PlayerTvView
        android:id="@+id/pv_player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:controller_layout_id="@layout/content_exo_controller_tv"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_subtitle_button="true"
        app:show_timeout="2000"
        app:surface_type="surface_view" />

    <com.mew.wlfmovie.fragments.player.settings.PlayerSettingsTvView
        android:id="@+id/settings"
        android:layout_width="350dp"
        android:layout_height="0dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- WLFMOVIE V4.5: Overlay "A continuación" rediseñado (compacto, arriba a la derecha) -->
    <LinearLayout
        android:id="@+id/layout_next_episode_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/wlf_bg_dialog"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/iv_next_episode_poster"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/glide_fallback_cover" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_next_episode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A CONTINUACIÓN"
                android:textAllCaps="true"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_next_episode_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wlf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="T1 E2" />

            <TextView
                android:id="@+id/tv_next_episode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="12sp"
                tools:text="El heredero" />

            <TextView
                android:id="@+id/tv_next_episode_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="11sp"
                tools:text="Reproduciendo en 8s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_next_episode_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wlf_bg_play_button_details"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_next_episode_dismiss"
                android:nextFocusRight="@id/btn_next_episode_dismiss"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="▶"
                android:textColor="@color/wlf_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/btn_next_episode_dismiss"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/wlf_bg_icon_button_tv"
                android:clickable="true"
                android:contentDescription="Cerrar"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_next_episode_action"
                android:nextFocusRight="@id/btn_next_episode_action"
                android:padding="4dp"
                android:src="@drawable/ic_player_settings_close"
                android:tint="@color/wlf_text_primary"
                tools:ignore="HardcodedText,UseAppTint" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
