<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE V6.3.1: Diálogo "Eliminar descarga".
  Copia del dialog_remove_continue_watching.xml con strings propios.
  Reutiliza wlf_bg_dialog (gradiente morado), wlf_bg_play_button_details
  (gradiente fucsia para el botón principal), wlf_bg_secondary_button_details
  (blanco semitransparente para Cancelar).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/wlf_bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Icono de eliminar (basura / X) -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_remote_stop"
        android:tint="@color/wlf_fuchsia_neon"
        tools:ignore="UseAppTint" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/wlf_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="@string/download_delete_dialog_title" />

    <!-- Mensaje -->
    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/wlf_text_secondary"
        android:textSize="14sp"
        tools:text="@string/download_delete_dialog_body" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Cancelar -->
        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/wlf_bg_secondary_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/download_delete_dialog_cancel"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Eliminar -->
        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/wlf_bg_play_button_details"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/download_delete_dialog_delete"
            android:textColor="@color/wlf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
