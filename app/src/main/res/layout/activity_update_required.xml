<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE: Pantalla de actualización requerida (V3).
  Fondo morado WlfMovie, changelog en markdown, botones grandes focusables.
  Funciona en mobile y TV.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wlf_bg_details_fragment">

    <ScrollView
        android:id="@+id/sv_update"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo WlfMovie -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/ic_wlfmovie_logo"
                android:importantForAccessibility="no"
                tools:ignore="ContentDescription" />

            <!-- Título -->
            <TextView
                android:id="@+id/tv_update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/wlf_text_primary"
                android:textSize="28sp"
                android:textAlignment="center"
                tools:text="Nueva versión disponible" />

            <!-- Versión -->
            <TextView
                android:id="@+id/tv_update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="18sp"
                tools:text="Versión 2.100" />

            <!-- Changelog en markdown -->
            <TextView
                android:id="@+id/tv_update_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:fontFamily="sans-serif-light"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/wlf_text_secondary"
                android:textSize="16sp" />

            <!-- Barra de progreso -->
            <ProgressBar
                android:id="@+id/pb_update_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:layout_marginBottom="8dp"
                android:progressTint="@color/wlf_fuchsia_neon"
                android:backgroundTint="@color/wlf_seekbar_track"
                android:visibility="gone"
                android:max="100"
                android:progress="0" />

            <!-- Texto de progreso -->
            <TextView
                android:id="@+id/tv_update_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"
                android:textColor="@color/wlf_fuchsia_neon"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="45%"
                tools:visibility="visible" />

            <!-- Botón Descargar e Instalar -->
            <TextView
                android:id="@+id/btn_update_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/wlf_bg_play_button_details"
                android:drawableStart="@drawable/wlf_ic_play"
                android:drawablePadding="12dp"
                android:drawableTint="@color/wlf_text_primary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Descargar e instalar"
                android:textColor="@color/wlf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Botón Descarga externa -->
            <TextView
                android:id="@+id/btn_update_external"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wlf_bg_secondary_button_details"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Descarga externa"
                android:textColor="@color/wlf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
