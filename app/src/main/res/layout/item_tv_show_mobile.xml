<?xml version="1.0" encoding="utf-8"?>
<!--
  WLFMOVIE: Item de serie para carrusel (mobile).
  Barra de progreso más alta (12dp), transparente el fondo, fucsia el progreso.
  IMPORTANTE: mantiene los IDs originales (iv_tv_show_poster, tv_tv_show_quality,
  pb_tv_show_progress, tv_tv_show_last_episode, tv_tv_show_title) para que
  TvShowViewHolder.displayMobileItem() funcione.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_tv_show_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="5"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="@id/iv_tv_show_poster"
        tools:text="HD"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_last_episode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="5"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_quality"
        app:layout_goneMarginTop="6dp"
        tools:text="S1 E1" />

    <!-- WLFMOVIE: Barra de progreso en la parte inferior de la carátula.
         Más alta (12dp), transparente el fondo, fucsia el progreso, sin bordes.
         Ocupa todo el ancho de la carátula. -->
    <ProgressBar
        android:id="@+id/pb_tv_show_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:progressDrawable="@drawable/wlf_progress_continue_watching"
        app:layout_constraintBottom_toBottomOf="@id/iv_tv_show_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintStart_toStartOf="@id/iv_tv_show_poster"
        tools:progress="80" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:lines="2"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tv_show_poster"
        tools:text="Title" />

</androidx.constraintlayout.widget.ConstraintLayout>
