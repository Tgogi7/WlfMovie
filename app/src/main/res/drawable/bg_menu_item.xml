<?xml version="1.0" encoding="utf-8"?>
<!-- WLFMOVIE: Fondo del item del nav lateral TV. Cápsula con borde fucsia. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#557C3AED" />
            <stroke android:width="2dp" android:color="#FFE879F9" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#337C3AED" />
            <stroke android:width="1dp" android:color="#99E879F9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
