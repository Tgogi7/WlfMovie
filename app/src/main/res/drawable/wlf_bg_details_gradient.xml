<?xml version="1.0" encoding="utf-8"?>
<!--
  Gradiente vertical para el banner de detalles.
  De transparente arriba a morado oscuro abajo, para que el título
  se lea bien sobre el backdrop.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#00000000"
        android:centerColor="#330F0518"
        android:endColor="#F00F0518"
        android:type="linear" />
</shape>
