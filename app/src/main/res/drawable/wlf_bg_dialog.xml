<?xml version="1.0" encoding="utf-8"?>
<!--
  Background para los diálogos del player WlfMovie.
  Rectángulo redondeado con gradiente morado oscuro y borde fucsia sutil.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1A0B2E"
        android:centerColor="#2A1648"
        android:endColor="#1A0B2E"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1.5dp"
        android:color="#77E879F9" />
</shape>
