<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del fragment de detalles - gradiente morado oscuro.
  De #0F0518 (morado muy oscuro) arriba a #000000 (negro) abajo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#0F0518"
        android:centerColor="#15082B"
        android:endColor="#000000"
        android:type="linear" />
</shape>
