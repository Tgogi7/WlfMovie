<?xml version="1.0" encoding="utf-8"?>
<!--
  Progreso de la barra vertical (la parte rellena).
  Gradiente morado→fucsia de abajo hacia arriba.
  Capsula redondeada para combinar con el track.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#7C3AED"
        android:endColor="#E879F9"
        android:type="linear" />
    <corners android:radius="3dp" />
</shape>
