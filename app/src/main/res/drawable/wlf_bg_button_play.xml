<?xml version="1.0" encoding="utf-8"?>
<!--
  Botón circular MÁS GRANDE para el play/pause (centro del player).
  Tiene más glow y más contraste que los de +10/-10.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="135"
        android:startColor="#7C3AED"
        android:centerColor="#5B21B6"
        android:endColor="#E879F9"
        android:type="linear" />
    <stroke
        android:width="2dp"
        android:color="#99F0ABFC" />
    <size
        android:width="72dp"
        android:height="72dp" />
</shape>
