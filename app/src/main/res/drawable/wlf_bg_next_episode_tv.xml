<?xml version="1.0" encoding="utf-8"?>
<!-- WLFMOVIE TV: Botón Siguiente episodio. Foco: borde BLANCO (rectangle con esquinas). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#A78BFA" android:endColor="#F0ABFC" android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7C3AED" android:endColor="#E879F9" android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#CC7C3AED" android:endColor="#CCE879F9" android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#99E879F9" />
        </shape>
    </item>
</selector>
