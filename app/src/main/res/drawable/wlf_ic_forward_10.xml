<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono "Adelantar 10 segundos" estilo Netflix - CORREGIDO.
  Arco horario (semicírculo por arriba) con cabeza de flecha a la derecha,
  y "10" abajo. La flecha apunta claramente hacia la derecha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

    <!-- Arco horario (semicírculo superior) - stroke grueso -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M 10,12 A 6,6 0 1 1 22,12" />

    <!-- Cabeza de flecha triangular en (22, 12) apuntando a la derecha -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 22,12 L 25,9 L 25,15 Z" />

    <!-- Número "1" - rectángulo vertical delgado -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 13,17 L 14,17 L 14,27 L 13,27 Z" />

    <!-- Número "0" - rectángulo con agujero (fillType evenOdd) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 17,17 L 21,17 L 21,27 L 17,27 Z M 18,18 L 20,18 L 20,26 L 18,26 Z" />

</vector>
