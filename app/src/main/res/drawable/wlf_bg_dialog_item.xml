<?xml version="1.0" encoding="utf-8"?>
<!--
  Background para cada item de la lista de un diálogo.
  Selector con estado pressed/focused.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55E879F9" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#99F0ABFC" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E879F9" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#FFE879F9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221A0B2E" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#44E879F9" />
        </shape>
    </item>
</selector>
