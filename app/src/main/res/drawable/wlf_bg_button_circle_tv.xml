<?xml version="1.0" encoding="utf-8"?>
<!-- WLFMOVIE TV: Botón circular. Foco: borde BLANCO grueso (oval). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#997C3AED" android:endColor="#99E879F9" android:type="linear" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#557C3AED" android:centerColor="#3A1F5C" android:endColor="#55E879F9" android:type="linear" />
            <stroke android:width="3.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="135" android:startColor="#337C3AED" android:centerColor="#2A1648" android:endColor="#33E879F9" android:type="linear" />
            <stroke android:width="1.5dp" android:color="#66E879F9" />
        </shape>
    </item>
</selector>
