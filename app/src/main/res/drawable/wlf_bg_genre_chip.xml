<?xml version="1.0" encoding="utf-8"?>
<!--
  Chip de género para Search.
  Capsula con borde, al seleccionarse se rellena con gradiente morado→fucsia.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#7C3AED"
                android:endColor="#E879F9"
                android:type="linear" />
            <corners android:radius="20dp" />
            <padding
                android:left="16dp"
                android:top="8dp"
                android:right="16dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221A0B2E" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#55E879F9" />
            <padding
                android:left="16dp"
                android:top="8dp"
                android:right="16dp"
                android:bottom="8dp" />
        </shape>
    </item>
</selector>
