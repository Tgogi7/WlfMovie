<?xml version="1.0" encoding="utf-8"?>
<!--
  Botón circular con gradiente morado→fucsia y sutil glow.
  Base para los botones de +10s, -10s y play/pause del player.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="135"
        android:startColor="#337C3AED"
        android:centerColor="#2A1648"
        android:endColor="#33E879F9"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#66E879F9" />
    <size
        android:width="56dp"
        android:height="56dp" />
</shape>
