<?xml version="1.0" encoding="utf-8"?>
<!--
  Ripple selector para botones circulares del player.
  Estado pressed: brillo fucsia. Estado normal: gradiente morado.
  Estado focused (TV D-pad): borde fucsia brillante.
  Nota: state_hover no es soportado en drawables AAPT, se omite.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#997C3AED"
                android:endColor="#99E879F9"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#FFF0ABFC" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#557C3AED"
                android:centerColor="#3A1F5C"
                android:endColor="#55E879F9"
                android:type="linear" />
            <stroke android:width="2.5dp" android:color="#FFE879F9" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#337C3AED"
                android:centerColor="#2A1648"
                android:endColor="#33E879F9"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#66E879F9" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
</selector>

