<?xml version="1.0" encoding="utf-8"?>
<!--
  Background del botón "Servers" - capsula con borde, sin relleno.
  Estilo "chip" moderno. Click → abre selector de servidores.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55E879F9" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFF0ABFC" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E879F9" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFF0ABFC" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221A0B2E" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#77E879F9" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
</selector>
