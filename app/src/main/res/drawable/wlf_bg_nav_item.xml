<?xml version="1.0" encoding="utf-8"?>
<!--
  Background de cada item del bottom nav WlfMovie.
  Al estar seleccionado: pill shape con gradiente morado→fucsia semi-transparente.
  Al no estar seleccionado: transparente.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E879F9" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <stroke
                android:width="1dp"
                android:color="#66E879F9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
