<?xml version="1.0" encoding="utf-8"?>
<!-- WLFMOVIE TV: Botón Servers. Foco: borde BLANCO (rectangle con esquinas). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55E879F9" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E879F9" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221A0B2E" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#77E879F9" />
        </shape>
    </item>
</selector>
